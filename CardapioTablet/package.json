{
  "name": "cardapio-tablet",
  "version": "2.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:rules": "node scripts/check-tablet-rules.js",
    "test:smoke": "npm run typecheck && npm run test:rules",
    "release:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-tablet.ps1",
    "smoke:adb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/adb-smoke-tablet.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.1.10",
    "expo": "^54.0.0",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "babel-preset-expo": "^54.0.12",
    "typescript": "~5.9.2"
  }
}
