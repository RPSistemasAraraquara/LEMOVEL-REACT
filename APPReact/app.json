{
  "expo": {
    "name": "RPMOVEL",
    "slug": "rpcheff-rn",
    "version": "52.0.0",
    "icon": "./assets/Logo.png",
    "orientation": "portrait",
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Permitir abrir a camera para ler o QRCode da mesa"
      }
    },
    "android": {
      "package": "br.com.sistemalechef.rpmobile",
      "versionCode": 105804,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir abrir a camera para ler o QRCode da mesa"
        }
      ],
      "./plugins/with-rpcheff-plugpag"
    ]
  }
}
